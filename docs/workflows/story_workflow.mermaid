flowchart TD

    Start((START))
    BackLogs[BACKLOGS]:::todo
    Ready[Ready]:::todo
    InProgress[In Progress]:::inprogress
    InReview[In Review]:::inprogress
    ReadyForSIT[Ready for SIT]:::inprogress
    INSIT[In SIT]:::inprogress
    INUAT[In UAT]:::inprogress
    Done[Done]:::done

    Start --> |Create| BackLogs
    BackLogs --> |Refine| Ready
    Ready --> |Start Development| InProgress
    InProgress --> |Submit for Review| InReview
    InReview --> |Approve for SIT| ReadyForSIT
    ReadyForSIT --> |Begin SIT| INSIT
    INSIT --> |Pass SIT| INUAT
    INUAT --> |Accept UAT| Done

    Ready --> |Not Ready| BackLogs
    InReview --> |Request Changes| InProgress
    INSIT --> |Fail SIT| InProgress
    INUAT --> |Fail UAT| InProgress

    classDef todo fill:#EBEDF0,stroke:#C0C1C2,stroke-width:2px;
    classDef inprogress fill:#EAE6FF,stroke:#403294,stroke-width:2px;
    classDef done fill:#E3FCEF,stroke:#006644,stroke-width:2px;